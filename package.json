{
  "name": "mybusiness-react",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/inject-precache.mjs",
    "build:analyze": "cross-env ANALYZE=1 vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:makeId": "node scripts/makeId-sanity.mjs",
    "test:domain": "node scripts/domain-sanity.mjs",
    "test:sync": "node scripts/sync-sanity.mjs",
    "test:scan": "node scripts/scan-sanity.mjs",
    "test:config": "node scripts/config-sanity.mjs",
    "test:sql": "node scripts/sql-sanity.mjs",
    "test:supabase": "node scripts/supabase-sanity.mjs",
    "test:supabase:push": "node scripts/supabase-pre-push-safety.mjs",
    "test:scripts": "node scripts/scripts-sanity.mjs",
    "test:pkg": "node scripts/pkg-sanity.mjs",
    "verify": "npm run build && npm run lint && npm run test:makeId && npm run test:domain && npm run test:sync && npm run test:scan && npm run test:config && npm run test:sql && npm run test:supabase && npm run test:supabase:push && npm run test:scripts && npm run test:pkg",
    "check": "npm run verify",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "preview": "vite preview",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link",
    "supabase:db:push": "supabase db push",
    "supabase:db:reset": "supabase db reset",
    "supabase:login": "supabase login"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "idb": "^8.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-virtuoso": "^4.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "^2.98.2",
    "vite": "^8.0.13"
  }
}
