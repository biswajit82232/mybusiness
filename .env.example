# Copy to `.env` / `.env.local` for local dev. Never commit real `.env` files (see `.gitignore`).
# App code reads these via `viteEnv` in src/config/env.js (single place for audits & tests).

# ── Public site URL (optional) ──────────────────────────────────────────────
# Full origin with no trailing slash, e.g. https://mybiz.vercel.app
# When set, the app sets absolute og:image / twitter:image for link previews.
VITE_PUBLIC_SITE_URL=

# ── Telemetry (optional) ─────────────────────────────────────────────────────
# URL that accepts POST with JSON error reports (e.g. a serverless function).
# Leave empty to disable.
VITE_TELEMETRY_URL=

# ── Supabase (optional) ─────────────────────────────────────────────────────
# Get URL + anon key from: Supabase Dashboard → Project Settings → API
# When both are set, sign-in uses Supabase Auth (email + password).
# When unset, the app uses local-only email/password (IndexedDB unchanged).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
